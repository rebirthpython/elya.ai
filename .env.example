# ===== Telegram =====
# Токен бота от @BotFather. Никому не показывай и не коммить в git.
BOT_TOKEN=
# Telegram ID пользователей, которым разрешён доступ (через запятую).
# Свой ID можно узнать у @userinfobot.
ALLOWED_USER_IDS=

# ===== AI-провайдеры (все бесплатные) =====
# Порядок = приоритет. Если модель недоступна или упёрлась в лимит — пробуется следующая.
# Провайдеры без ключа пропускаются: чтобы подключить новый, достаточно вписать его ключ.
# Чем больше ключей, тем реже Эля упирается в лимиты. Список моделей любого провайдера
# можно заменить через <ИМЯ>_MODELS (через запятую, в порядке приоритета).
# Модель, которую убрали из бесплатного каталога, бот сам откладывает на 6 часов.
# Посмотреть, что подключено, — команда /models в боте.
AI_PROVIDERS=gemini,github,mistral,groq,cerebras,openrouter,nvidia,cloudflare,zai,gigachat,cohere,huggingface,ovh,kilo,llm7,pollinations

# --- Google Gemini: ключ — https://aistudio.google.com/apikey (без карты) ---
# *-latest — алиасы на актуальные версии. Недоступен с серверов в РФ.
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest

# --- GitHub Models: GPT-4.1 и другие бесплатно для любого аккаунта GitHub ---
# Токен — https://github.com/settings/personal-access-tokens (fine-grained,
# в Permissions → Account permissions → Models: Read-only).
# Лимиты небольшие (десятки запросов в день на модель), ответ — до 4000 токенов.
GITHUB_API_KEY=
# GITHUB_MODELS=openai/gpt-4.1,openai/gpt-4.1-mini,openai/gpt-4o-mini

# --- Mistral AI: ключ — https://console.mistral.ai/api-keys ---
# Бесплатный план Experiment (нужен номер телефона); запросы могут использоваться для обучения.
MISTRAL_API_KEY=
# MISTRAL_MODELS=mistral-large-latest,mistral-medium-latest,mistral-small-latest

# --- Groq: ключ — https://console.groq.com/keys ---
# Этот же ключ включает распознавание голосовых (Whisper), даже если groq нет в AI_PROVIDERS.
# Актуальные модели: https://console.groq.com/docs/models
GROQ_API_KEY=
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,llama-3.3-70b-versatile,openai/gpt-oss-20b
# SPEECH_MODEL=whisper-large-v3-turbo

# --- Cerebras: ключ — https://cloud.cerebras.ai ---
# Условия бесплатного доступа менялись (бывает разовый пробный кредит) — проверь в кабинете.
CEREBRAS_API_KEY=
# CEREBRAS_MODELS=gpt-oss-120b

# --- OpenRouter: ключ — https://openrouter.ai/keys ---
# Бесплатные модели — с суффиксом :free (около 50 запросов в сутки на все сразу).
# openrouter/free — роутер, который сам выбирает доступную бесплатную модель.
# Актуальный список: https://openrouter.ai/models?max_price=0
OPENROUTER_API_KEY=
# OPENROUTER_MODELS=google/gemma-4-31b-it:free,openrouter/free

# --- NVIDIA NIM: ключ — https://build.nvidia.com (бесплатная программа NVIDIA Developer) ---
# Для прототипов и личного использования; запросы логируются NVIDIA.
NVIDIA_API_KEY=
# NVIDIA_MODELS=openai/gpt-oss-120b,nvidia/nemotron-3-ultra-550b-a55b,meta/llama-3.3-70b-instruct

# --- Cloudflare Workers AI: 10 000 «нейронов» в сутки бесплатно, без карты ---
# Токен — https://dash.cloudflare.com/profile/api-tokens (шаблон «Workers AI»),
# ID аккаунта — на главной странице панели Cloudflare (Account ID).
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_MODELS=@cf/meta/llama-3.3-70b-instruct-fp8-fast,@cf/zai-org/glm-4.7-flash,@cf/openai/gpt-oss-120b

# --- Z.ai (GLM): ключ — https://z.ai/manage-apikey/apikey-list ---
# Модели *-flash бесплатные. Китайская платформа BigModel — ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZAI_API_KEY=
# ZAI_MODELS=glm-4.7-flash,glm-4.5-flash

# --- GigaChat (Сбер): работает с серверов в России, бесплатный тариф Freemium для физлиц ---
# Ключ авторизации (Authorization key) — https://developers.sber.ru/studio → проект GigaChat API.
# Серверы Сбера используют сертификат НУЦ Минцифры. Если в логе «TLS certificate is not trusted»,
# скачай корневой сертификат на https://www.gosuslugi.ru/crt (формат PEM) и укажи путь к нему:
# GIGACHAT_CA_BUNDLE=/path/to/russian_trusted_root_ca.pem
GIGACHAT_API_KEY=
# GIGACHAT_MODELS=GigaChat-2
# GIGACHAT_SCOPE=GIGACHAT_API_PERS

# --- Cohere: пробный ключ — https://dashboard.cohere.com/api-keys ---
# Бесплатно для некоммерческого использования, около 1000 запросов в месяц.
COHERE_API_KEY=
# COHERE_MODELS=command-a-03-2025,command-r-plus-08-2024

# --- Hugging Face: токен — https://huggingface.co/settings/tokens ---
# (fine-grained, право «Make calls to Inference Providers»). Небольшой бесплатный кредит в месяц.
HUGGINGFACE_API_KEY=
# HUGGINGFACE_MODELS=openai/gpt-oss-120b,Qwen/Qwen3-235B-A22B-Instruct-2507

# --- Работают БЕЗ КЛЮЧА: запасной вариант, если все остальные упёрлись в лимиты ---
# Лимиты маленькие (несколько запросов в минуту с одного IP), гарантий нет.
# Чтобы не отправлять им сообщения, убери их из AI_PROVIDERS.
# OVHcloud AI Endpoints (дата-центры в ЕС). Без ключа — бесплатно; с ключом — ПЛАТНО за токены.
# OVH_MODELS=Qwen3.5-397B-A17B,gpt-oss-120b,Meta-Llama-3_3-70B-Instruct
# Kilo Gateway: бесплатные модели без ключа; роутер может отправить запрос провайдеру,
# который сохраняет запросы.
# KILO_MODELS=kilo-auto/free
# LLM7.io: без ключа; бесплатный токен с https://token.llm7.io поднимает лимиты.
# LLM7_API_KEY=
# Pollinations: без ключа; ключ с https://enter.pollinations.ai поднимает лимиты.
# POLLINATIONS_API_KEY=

# --- Фото ---
# Запросы с картинками идут только к моделям из <ИМЯ>_VISION_MODELS. По умолчанию они
# заданы для Gemini, GitHub, Mistral, Groq, OpenRouter, NVIDIA, Cloudflare, Z.ai, Cohere,
# OVH и Pollinations (см. /models). «*» — все модели из <ИМЯ>_MODELS, «-» — без фото. Пример:
# OPENROUTER_VISION_MODELS=google/gemma-4-31b-it:free

# --- Тонкая настройка любого провайдера ---
# <ИМЯ>_BASE_URL — другой адрес API, <ИМЯ>_MAX_TOKENS — потолок длины ответа,
# <ИМЯ>_CA_BUNDLE — свой корневой сертификат (PEM) для HTTPS.

# --- Любой OpenAI-совместимый сервер, например локальная Ollama ---
# Добавь custom в AI_PROVIDERS.
# CUSTOM_BASE_URL=http://localhost:11434/v1
# CUSTOM_MODELS=qwen2.5:7b
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODELS=

# ===== Mini App (HTML5-приложение внутри Telegram) =====
# Публичный HTTPS-адрес, по которому Telegram откроет приложение. Пусто — Mini App выключен,
# работает только чат с ботом. Как получить адрес — см. раздел «Mini App» в README.
WEBAPP_URL=
# Адрес и порт, на которых бот поднимает веб-сервер приложения (за туннелем или прокси).
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
# Сколько секунд действует вход в приложение после его открытия
WEBAPP_AUTH_MAX_AGE=86400

# ===== Ассистент =====
ASSISTANT_NAME=Эля
# Максимум токенов в ответе модели
MAX_OUTPUT_TOKENS=2048
TEMPERATURE=0.7
# Таймаут запроса к модели, сек.
REQUEST_TIMEOUT=60

# ===== Конспекты и презентации (/notes, /slides) =====
# Максимум токенов в ответе модели: конспекту и презентации нужно больше, чем реплике в чате
STUDY_MAX_OUTPUT_TOKENS=8192
# Максимальный размер материала в символах (час лекции в расшифровке — примерно 50 000)
STUDY_MAX_INPUT_CHARS=60000

# ===== Память =====
# Сколько последних сообщений и символов истории передавать модели
HISTORY_MAX_MESSAGES=30
HISTORY_MAX_CHARS=12000
# Сколько сообщений хранить в базе (более старые удаляются)
HISTORY_STORE_LIMIT=500

# ===== Защита =====
# Сообщений в минуту от пользователя
RATE_LIMIT_PER_MINUTE=10
# Запросов к AI-провайдерам в сутки (UTC), 0 — без ограничения
DAILY_REQUEST_LIMIT=300

# ===== Прочее =====
DATABASE_URL=sqlite+aiosqlite:///data/assistant.db
LOG_LEVEL=INFO
