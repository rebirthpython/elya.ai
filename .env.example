# ===== Telegram =====
# Токен бота от @BotFather. Никому не показывай и не коммить в git.
BOT_TOKEN=
# Telegram ID пользователей, которым разрешён доступ (через запятую).
# Свой ID можно узнать у @userinfobot.
ALLOWED_USER_IDS=

# ===== AI-провайдеры =====
# Порядок = приоритет. Если первый недоступен или упёрся в лимит — пробуется следующий.
# Провайдеры без ключа пропускаются. Доступны: gemini, openrouter, groq, mistral, custom
AI_PROVIDERS=gemini,openrouter,groq,mistral

# Google Gemini API: ключ — https://aistudio.google.com/apikey
# Модели через запятую в порядке приоритета. *-latest — алиасы на актуальные версии.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest

# OpenRouter (резерв): ключ — https://openrouter.ai/keys
# Бесплатные модели имеют суффикс :free, их список часто меняется —
# проверь актуальные на https://openrouter.ai/models?max_price=0
# openrouter/free — роутер, который сам выбирает одну из доступных бесплатных моделей;
# он стоит последним как запасной вариант на случай, если конкретную модель убрали.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,openrouter/free

# Фото: запросы с картинками идут только к моделям из <ИМЯ>_VISION_MODELS.
# По умолчанию: Gemini — все его модели (*), Groq — meta-llama/llama-4-scout-17b-16e-instruct,
# остальные — никакие. «-» отключает фото у провайдера. Пример для OpenRouter:
# OPENROUTER_VISION_MODELS=qwen/qwen2.5-vl-72b-instruct:free

# Groq (опционально): ключ — https://console.groq.com/keys
# Этот же ключ включает распознавание голосовых сообщений (Whisper), даже если groq нет в AI_PROVIDERS.
# SPEECH_MODEL=whisper-large-v3-turbo
# Актуальные модели и лимиты: https://console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODELS=llama-3.3-70b-versatile

# Mistral AI (опционально): ключ — https://console.mistral.ai/api-keys
# Бесплатный план Experiment: данные запросов могут использоваться для обучения моделей.
MISTRAL_API_KEY=
MISTRAL_MODELS=mistral-small-latest

# Любой OpenAI-совместимый сервер, например локальная Ollama:
# CUSTOM_BASE_URL=http://localhost:11434/v1
# CUSTOM_MODELS=qwen2.5:7b
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODELS=

# ===== Картинки («нарисуй …», /draw) =====
# Сервисы в порядке приоритета; без ключа сервис пропускается, без ключей рисование выключено.
# Доступны: cloudflare, pollinations, custom. Подробности — в README, раздел «Картинки».
IMAGE_PROVIDERS=cloudflare,pollinations

# Cloudflare Workers AI (бесплатно ~170 картинок в сутки): Account ID и токен с шаблоном
# «Workers AI» — https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Pollinations: секретный ключ sk_… — https://enter.pollinations.ai
POLLINATIONS_API_KEY=
# POLLINATIONS_IMAGE_MODEL=black-forest-labs/flux.1-schnell

# Любой OpenAI-совместимый Images API (POST {base_url}/images/generations), например OpenAI:
# IMAGE_CUSTOM_BASE_URL=https://api.openai.com/v1
# IMAGE_CUSTOM_API_KEY=
# IMAGE_CUSTOM_MODEL=gpt-image-1

# Картинок в сутки (UTC), отдельно от DAILY_REQUEST_LIMIT; 0 — без ограничения
IMAGE_DAILY_LIMIT=50

# ===== Поиск в интернете =====
# Работает сразу, без ключей: запасной вариант — DuckDuckGo. Ключи ниже необязательны,
# но надёжнее (DuckDuckGo без ключа может временно показать проверку «вы не робот»).
# Все сервисы регистрируются без карты; можно указать несколько.
# Tavily — https://tavily.com (1 000 запросов в месяц)
TAVILY_API_KEY=
# Brave Search API — https://brave.com/search/api (бесплатный кредит каждый месяц)
BRAVE_API_KEY=
# Serper.dev, выдача Google — https://serper.dev (2 500 запросов один раз при регистрации)
SERPER_API_KEY=
# SerpApi, выдача Google — https://serpapi.com (250 запросов в месяц, до 50 в час)
SERPAPI_API_KEY=
# Порядок = приоритет: при ошибке первого сервиса бот попробует следующий.
# Сервисы без ключа пропускаются.
SEARCH_PROVIDERS=serper,serpapi,tavily,brave,duckduckgo
# DuckDuckGo без ключа (последним, если его нет в списке выше); false — без ключей поиск выключен
SEARCH_DUCKDUCKGO=true
# true — Эля сама решает, когда искать (свежие новости, цены, погода…);
# false — только по просьбе: /search, «погугли …», «найди в интернете …», кнопка 🌐 в приложении
SEARCH_AUTO=true
# Язык выдачи и страна (ru, ua, kz, by…). Пустая страна — по умолчанию сервиса
SEARCH_LANGUAGE=ru
SEARCH_REGION=
# Сколько результатов передавать модели (1–10)
SEARCH_MAX_RESULTS=6
# Поисков в сутки (UTC), 0 — без ограничения. С одним SerpApi разумно около 8 (250 в месяц)
SEARCH_DAILY_LIMIT=100

# ===== Mini App (HTML5-приложение внутри Telegram) =====
# Публичный HTTPS-адрес, по которому Telegram откроет приложение. Пусто — Mini App выключен,
# работает только чат с ботом. Как получить адрес — см. раздел «Mini App» в README.
WEBAPP_URL=
# Адрес и порт, на которых бот поднимает веб-сервер приложения (за туннелем или прокси).
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
# Сколько секунд действует вход в приложение после его открытия
WEBAPP_AUTH_MAX_AGE=86400

# ===== Ассистент =====
ASSISTANT_NAME=Эля
# Максимум токенов в ответе модели
MAX_OUTPUT_TOKENS=2048
TEMPERATURE=0.7
# Таймаут запроса к модели, сек.
REQUEST_TIMEOUT=60

# ===== Конспекты и презентации (/notes, /slides) =====
# Максимум токенов в ответе модели: конспекту и презентации нужно больше, чем реплике в чате
STUDY_MAX_OUTPUT_TOKENS=8192
# Максимальный размер материала в символах (час лекции в расшифровке — примерно 50 000)
STUDY_MAX_INPUT_CHARS=60000

# ===== Монтаж видео (/video) =====
# Нужен ffmpeg: Termux — pkg install ffmpeg, Ubuntu/Debian — sudo apt install ffmpeg fonts-dejavu-core.
# Без него бот работает, но монтаж выключен. Субтитры распознаёт Groq Whisper (нужен GROQ_API_KEY).
# Пути к ffmpeg и ffprobe, если их нет в PATH
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# Папка для временных файлов монтажа; пусто — временная папка системы (стирается при запуске бота)
# VIDEO_WORKDIR=
# Сколько клипов можно смонтировать за раз
VIDEO_MAX_CLIPS=10
# Максимальная длина результата, сек.
VIDEO_MAX_SECONDS=600
# Максимальная длинная сторона кадра, px (1920 — Full HD; на слабом телефоне можно 1280)
VIDEO_MAX_SIDE=1920
# Сколько секунд может работать один запуск ffmpeg
VIDEO_TIMEOUT=900
# Максимальный размер видео, загруженного через приложение, МБ (из чата с ботом — всегда до 20 МБ)
VIDEO_UPLOAD_MAX_MB=100

# ===== Режим кода (/code) =====
# Максимум токенов в ответе: коду нужно больше места, чем обычной реплике
CODE_MAX_OUTPUT_TOKENS=4096
# Чем ниже температура, тем точнее и предсказуемее код
CODE_TEMPERATURE=0.2
# Сколько символов истории передавать модели в режиме кода (в неё попадают и присланные файлы)
CODE_HISTORY_MAX_CHARS=40000
# Сколько символов читать из присланного файла с кодом (остальное обрезается)
CODE_MAX_FILE_CHARS=30000

# ===== Память =====
# Сколько последних сообщений и символов истории передавать модели
HISTORY_MAX_MESSAGES=30
HISTORY_MAX_CHARS=12000

# ===== Защита =====
# Сообщений в минуту от пользователя
RATE_LIMIT_PER_MINUTE=10
# Запросов к AI-провайдерам в сутки (UTC), 0 — без ограничения
DAILY_REQUEST_LIMIT=300

# ===== Прочее =====
DATABASE_URL=sqlite+aiosqlite:///data/assistant.db
LOG_LEVEL=INFO
