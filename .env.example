# ===== Telegram =====
# Токен бота от @BotFather. Никому не показывай и не коммить в git.
BOT_TOKEN=
# Telegram ID пользователей, которым разрешён доступ (через запятую).
# Свой ID можно узнать у @userinfobot.
ALLOWED_USER_IDS=

# ===== AI-провайдеры =====
# Порядок = приоритет. Если первый недоступен или упёрся в лимит — пробуется следующий.
# Провайдеры без ключа пропускаются. Доступны: gemini, openrouter, groq, mistral, custom
AI_PROVIDERS=gemini,openrouter,groq,mistral

# Google Gemini API: ключ — https://aistudio.google.com/apikey
# Модели через запятую в порядке приоритета. *-latest — алиасы на актуальные версии.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest

# OpenRouter (резерв): ключ — https://openrouter.ai/keys
# Бесплатные модели имеют суффикс :free, их список часто меняется —
# проверь актуальные на https://openrouter.ai/models?max_price=0
# openrouter/free — роутер, который сам выбирает одну из доступных бесплатных моделей;
# он стоит последним как запасной вариант на случай, если конкретную модель убрали.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,openrouter/free

# Фото: запросы с картинками идут только к моделям из <ИМЯ>_VISION_MODELS.
# По умолчанию: Gemini — все его модели (*), Groq — meta-llama/llama-4-scout-17b-16e-instruct,
# остальные — никакие. «-» отключает фото у провайдера. Пример для OpenRouter:
# OPENROUTER_VISION_MODELS=qwen/qwen2.5-vl-72b-instruct:free

# Groq (опционально): ключ — https://console.groq.com/keys
# Этот же ключ включает распознавание голосовых сообщений (Whisper), даже если groq нет в AI_PROVIDERS.
# SPEECH_MODEL=whisper-large-v3-turbo
# Актуальные модели и лимиты: https://console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODELS=llama-3.3-70b-versatile

# Mistral AI (опционально): ключ — https://console.mistral.ai/api-keys
# Бесплатный план Experiment: данные запросов могут использоваться для обучения моделей.
MISTRAL_API_KEY=
MISTRAL_MODELS=mistral-small-latest

# Любой OpenAI-совместимый сервер, например локальная Ollama:
# CUSTOM_BASE_URL=http://localhost:11434/v1
# CUSTOM_MODELS=qwen2.5:7b
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODELS=

# ===== Mini App (HTML5-приложение внутри Telegram) =====
# Публичный HTTPS-адрес, по которому Telegram откроет приложение. Пусто — Mini App выключен,
# работает только чат с ботом. Как получить адрес — см. раздел «Mini App» в README.
WEBAPP_URL=
# Адрес и порт, на которых бот поднимает веб-сервер приложения (за туннелем или прокси).
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
# Сколько секунд действует вход в приложение после его открытия
WEBAPP_AUTH_MAX_AGE=86400

# ===== Ассистент =====
ASSISTANT_NAME=Эля
# Максимум токенов в ответе модели
MAX_OUTPUT_TOKENS=2048
TEMPERATURE=0.7
# Таймаут запроса к модели, сек.
REQUEST_TIMEOUT=60

# ===== Память =====
# Сколько последних сообщений и символов истории передавать модели
HISTORY_MAX_MESSAGES=30
HISTORY_MAX_CHARS=12000
# Сколько сообщений хранить в базе (более старые удаляются)
HISTORY_STORE_LIMIT=500

# ===== Защита =====
# Сообщений в минуту от пользователя
RATE_LIMIT_PER_MINUTE=10
# Запросов к AI-провайдерам в сутки (UTC), 0 — без ограничения
DAILY_REQUEST_LIMIT=300

# ===== Прочее =====
DATABASE_URL=sqlite+aiosqlite:///data/assistant.db
LOG_LEVEL=INFO
